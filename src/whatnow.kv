<Root>:
    orientation: "horizontal" if self.width >= 800 else "vertical"
    BoxLayout:
        id: nav_bar
        orientation: "horizontal"
        size_hint_x: None if root.width >= 800 else 1
        size_hint_y: None if root.width < 800 else 1
        width: 120 if root.width >= 800 else 0
        height: 60 if root.width < 800 else 0
        spacing: 10
        padding: [0, 10] if root.width >= 800 else [10, 0]
        canvas.before:
            Color:
                rgba: 0.325, 0.325, 0.325, 1
            Rectangle:
                pos: self.x - 1, self.y - 1
                size: self.width + 2, self.height + 2
            Color:
                rgba: 0.157, 0.157, 0.157, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [5]
        AnchorLayout:
            anchor_x: "center"
            anchor_y: "top"
            size_hint_y: 1 if root.width >= 800 else None
            size_hint_x: None if root.width >= 800 else 1
            width: 120 if root.width >= 800 else 0
            height: 60 if root.width < 800 else 0
            BoxLayout:
                orientation: "vertical" if root.width >= 800 else "horizontal"
                size_hint: (1, None) if root.width >= 800 else (None, 1)
                height: 150 if root.width >= 800 else 0  # 3 buttons * 50

                width: 0 if root.width >= 800 else 360   # expand horizontally on mobile

                spacing: 0 
                NavButton:
                    id: home_button
                    text: "[b]Home[/b]"
                    screen_name: "home"
                    size_hint_y: None if root.width >= 800 else 1
                    height: 50 if root.width >= 800 else 0
                    on_release: root.set_active(self.screen_name)
                NavButton:
                    id: voice_button
                    text: "Voice"
                    screen_name: "voice"
                    color: 0.6, 0.6, 0.6, 1
                    size_hint_y: None if root.width >= 800 else 1
                    height: 50 if root.width >= 800 else 0
                    on_release: root.set_active(self.screen_name)
                NavButton:
                    id: scanner_button
                    text: "Scanner"
                    screen_name: "scanner"
                    color: 0.6, 0.6, 0.6, 1
                    size_hint_y: None if root.width >= 800 else 1
                    height: 50 if root.width >= 800 else 0
                    on_release: root.set_active(self.screen_name)

    ScreenManager:
        id: sm
        size_hint_x: 1
        size_hint_y: 1
        Home:
            name: "home"
        Voice:
            name: "voice"
        Scanner:
            name: "scanner"

<Home>:
    ScrollView:
        do_scroll_x: False
        do_scroll_y: True

        id: home_root

        BoxLayout:
            orientation: "vertical"
            padding: 10
            spacing: 10
            size_hint_y: None  # Don't let it shrink to fit ScrollView

            height: self.minimum_height  # Expand to fit all children

            BoxLayout:
                orientation: "horizontal"
                padding: 10
                spacing: 10
                size_hint_y: None  # Don't let it shrink to fit ScrollView

                height: self.minimum_height  # Expand to fit all children

                # Month Header
                HeaderLabel:
                    id: calendar_month_label
                    text: "[b]February[/b]"
                    halign: "left"
                    size_hint_y: None
                    height: self.texture_size[1]
                    text_size: self.width, None

                PrimaryButton:
                    id: RUN_LLM_TEST
                    text: "test"
                    size_hint_x: None
                    size_hint_y: None
                    height: '36dp'
                    width: '36dp'
                    disabled: False

                PrimaryButton:
                    id: change_view_type_button
                    text: '[b]Change View[/b]'
                    size_hint_x: None
                    size_hint_y: None
                    height: '36dp'
                    width: '100dp'
                    disabled: False

                PrimaryButton:
                    id: search_event_button 
                    text: '[b]Search[/b]'
                    size_hint_x: None
                    size_hint_y: None
                    height: '36dp'
                    width: '50dp'
                    disabled: False

                PrimaryButton:
                    id: add_event_button 
                    text: '[b]Add Event[/b]'
                    size_hint_x: None
                    size_hint_y: None
                    height: '36dp'
                    width: '100dp'
                    disabled: False

            # Calendar Box
            ThemedBox:
                orientation: "vertical"
                padding: 10
                spacing: 6
                size_hint_y: None
                height: self.minimum_height

                # Day-of-week header row
                BoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: 20
                    spacing: 2

                    Label:
                        text: "S"
                        font_size: "11sp"
                        color: 0.541, 0.541, 0.541, 1
                        halign: "center"
                    Label:
                        text: "M"
                        font_size: "11sp"
                        color: 0.541, 0.541, 0.541, 1
                        halign: "center"
                    Label:
                        text: "T"
                        font_size: "11sp"
                        color: 0.541, 0.541, 0.541, 1
                        halign: "center"
                    Label:
                        text: "W"
                        font_size: "11sp"
                        color: 0.541, 0.541, 0.541, 1
                        halign: "center"
                    Label:
                        text: "T"
                        font_size: "11sp"
                        color: 0.541, 0.541, 0.541, 1
                        halign: "center"
                    Label:
                        text: "F"
                        font_size: "11sp"
                        color: 0.541, 0.541, 0.541, 1
                        halign: "center"
                    Label:
                        text: "S"
                        font_size: "11sp"
                        color: 0.541, 0.541, 0.541, 1
                        halign: "center"

                # Calendar grid — populated from Python
                GridLayout:
                    id: calendar_grid
                    cols: 7
                    spacing: 2
                    size_hint_y: None
                    height: self.minimum_height

            HeaderLabel:
                id: events_box_header_label
                text: "[b]Today's Events[/b]"
                halign: "left"
                size_hint_y: None
                height: self.texture_size[1]
                text_size: self.width, None

            # Upcoming events box
            ThemedBox:
                id: events_box
                orientation: "vertical"
                padding: 10
                spacing: 10
                
                size_hint_y: None  # Don't let it shrink to fit ScrollView

                height: self.minimum_height  # Expand to fit all children

                # Test Box of upcoming Events
                BoxLayout:
                    orientation: "vertical"
                    padding: 10
                    spacing: 4
                    size_hint_y: None  # Don't let it shrink to fit ScrollView

                    height: self.minimum_height  # Expand to fit all children

<Voice>:
    BoxLayout:
        orientation: "vertical"
        padding: 10
        spacing: 10

        id: voice_root

        HeaderLabel:
            text: "[b]Voice[/b]"
            halign: "left"
            size_hint_y: None
            height: self.texture_size[1]
            text_size: self.width, None

        # Mic icon and text label in the center
        AnchorLayout:
            anchor_x: "center"
            anchor_y: "center"

            BoxLayout:
                orientation: "vertical"
                spacing: 20
                size_hint_x: 0.95
                size_hint_y: None
                size: self.minimum_size

                BoxLayout:
                    id: voice_box_container
                    size_hint_x: 1
                    size_hint_y: None
                    height: "50dp"
                    padding: dp(1)
                    
                    canvas.before:
                        # Border
                        Color:
                            rgba: 0.325, 0.325, 0.325, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [10]

                        # Fill
                        Color:
                            rgba: 0.157, 0.157, 0.157, 1
                        RoundedRectangle:
                            pos: self.x + 1, self.y + 1
                            size: self.width - 2, self.height - 2
                            radius: [10]

                    VoiceTextInput:

                        id: voice_text_input  #will be used to show voice input to user

                        hint_text: "Record to start!"
                        font_size: "16sp"
                        size_hint_x: 1

                        size_hint_y: None
                        height: "50dp"

                Image:
                    id: mic_icon
                    source: "../mic_white.png"
                    size_hint: None, None
                    size: "96dp", "96dp"
                    pos_hint: {"center_x": 0.5}


        PrimaryButton:
            id: record_button
            text: "Record"
            size_hint_y: None
            height: "48dp"

            on_release: root.start_voice()
        PrimaryButton:
            id: submit_voice_button
            text: "Submit"
            disabled: True
            size_hint_y: None
            height: "48dp"

            on_release: root.submit_voice()

<NavButton>:
    markup: True
    background_normal: ""
    background_down: ""
    background_color: 0.157, 0.157, 0.157, 1  # background color

    color: (0.4, 0.4, 0.4, 1) if self.state == "down" else (1, 1, 1, 1)
    font_size: "16sp"

<ThemedSpinner>:
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: 0, 0, 0, 1
    canvas.before:
        Color:
            rgba: (0.302, 0.659, 0.910, 1) if self.state == 'down' else (0.9, 0.9, 0.9, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [5]

    canvas.after:
        Color:
            rgba: (0.302, 0.659, 0.910, 1)
        Triangle:
            points:
                [ self.right - 20, self.y + self.height * 0.55, self.right - 8,  self.y + self.height * 0.55, self.right - 14, self.y + self.height * 0.35 ]

<ThemedCheckBox>:
    background_checkbox_normal: ''
    background_checkbox_down: ''
    background_radio_normal: ''
    background_radio_down: ''
    color: 0, 0, 0, 0
    canvas.before:
        # Outer white rounded rectangle
        Color:
            rgba: (1, 1, 1, 1)
        RoundedRectangle:
            pos: self.center_x - self.height / 2, self.center_y - self.height / 2
            size: self.height, self.height
            radius: [6]
        # Blue inner rounded rectangle (only when checked)
        Color:
            rgba: (0.302, 0.659, 0.910, 1) if self.active else (0, 0, 0, 0)
        RoundedRectangle:
            pos: self.center_x - self.height / 2, self.center_y - self.height / 2
            size: self.height, self.height
            radius: [6]

<ThemedSpinnerOption>:
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: 0, 0, 0, 1
    canvas.before:
        Color:
            rgba: (0.302, 0.659, 0.910, 1) if self.state == 'down' else (0.9, 0.9, 0.9, 1)
        Rectangle:
            pos: self.pos
            size: self.size
        Color:
            rgba: (0.8, 0.8, 0.8, 1)
        Line:
            points: self.x, self.y, self.right, self.y
            width: 2

<ThemedBox>:
    background_normal: ""
    background_active: ""
    background_color: 1, 1, 1, 0

    canvas.before:
        # Border
        Color:
            rgba: 0.325, 0.325, 0.325, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [10]

        # Fill
        Color:
            rgba: 0.157, 0.157, 0.157, 1
        RoundedRectangle:
            pos: self.x + 1, self.y + 1
            size: self.width - 2, self.height - 2
            radius: [10]

<VoiceTextInput>:
    background_normal: ""
    background_active: ""
    background_color: 1, 1, 1, 0

    foreground_color: 1, 1, 1, 1
    disabled_foreground_color: 1, 1, 1, 1
    cursor_color: 1, 1, 1, 1
    selection_color: 0.3, 0.3, 0.3, 0.5

    padding: dp(12), dp(10)
    multiline: True
    line_height: 1

<ThemedToggleButton>:
    markup: True
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    disabled_color: 0.33, 0.33, 0.33, 1
    canvas.before:
        Color:
            rgba: (0.302, 0.659, 0.910, 1) if self.state == 'down' else (0.9, 0.9, 0.9, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [5]

<PrimaryButton>:
    markup: True

    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0   # Disable default fill

    color: 0, 0, 0, 1
    disabled_color: 0.33, 0.33, 0.33, 1
    #background_normal: ""
            #background_down: ""
            #background_color:
                #(0.78, 0.36, 0.14, 1) if self.state == 'down' else (0.06, 0.12, 0.30, 1)

    canvas.before:
        Color:
            rgba:
                (0.9, 0.9, 0.9, 1) if self.disabled else (0.7, 0.7, 0.7, 1) if self.state == 'down' else (1, 1, 1, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [5]

<ThemedPopup>:
    title: ""
    separator_height: 0

    title_size: 0.0001      # Effectively removes bar
    title_align: "center"

    background: ""
    background_color: 1, 1, 1, 0
    overlay_color: 0, 0, 0, 0

    canvas.before:
        Color:
            rgba: 0.157, 0.157, 0.157, 1   # #282828

        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [5]

<HeaderLabel>:
    markup: True
    font_size: "32px"

<CalendarDayCell>:
    orientation: "vertical"
    size_hint_y: None
    height: self.minimum_height
    spacing: 2
    padding: 2
    Label:
        text: root.day_text
        font_size: "14sp"
        halign: "center"
        size_hint_y: None
        height: 24
        color: root.day_color
    BoxLayout:
        id: event_bars
        orientation: "vertical"
        size_hint_y: None
        height: self.minimum_height
        spacing: 4

<CalendarDayToday>:
    orientation: "vertical"
    size_hint_y: None
    height: self.minimum_height
    spacing: 2
    padding: 2

    # Blue circle for today
    Label:
        text: root.day_text
        font_size: "12sp"
        bold: True
        halign: "center"
        size_hint_y: None
        height: 24
        canvas.before:
            Color:
                rgba: 0.302, 0.659, 0.910, 1
            Ellipse:
                pos: self.x + self.width/2 - 12, self.y
                size: 24, 24
    BoxLayout:
        id: event_bars
        orientation: "vertical"
        size_hint_y: None
        height: self.minimum_height
        spacing: 4

<EventItem>:
    orientation: "vertical"
    padding: [4, 6]
    spacing: 2
    size_hint_y: None
    height: self.minimum_height

    Label:
        markup: True
        text: "[b]" + root.event_name + "[/b]"
        halign: "left"
        font_size: "12sp"
        size_hint_y: None
        height: self.texture_size[1]
        text_size: self.width, None

    Label:
        text: root.event_date
        halign: "left"
        font_size: "11sp"
        color: 0.541, 0.541, 0.541, 1
        size_hint_y: None
        height: self.texture_size[1]
        text_size: self.width, None

    Label:
        text: root.event_time
        halign: "left"
        font_size: "11sp"
        color: 0.541, 0.541, 0.541, 1
        size_hint_y: None
        height: self.texture_size[1]
        text_size: self.width, None

<EditEventItem>:
    orientation: "horizontal"
    padding: [4, 6]
    spacing: 2
    size_hint_y: None
    height: self.minimum_height

    BoxLayout:
        id: event_details 
        orientation: "vertical"
        size_hint_y: None
        height: self.minimum_height
        spacing: 4

        Label:
            markup: True
            text: "[b]" + root.event_name + "[/b]"
            halign: "left"
            font_size: "14sp"
            size_hint_y: None
            height: self.texture_size[1]
            text_size: self.width, None
        Label:
            text: root.event_date
            halign: "left"
            font_size: "11sp"
            color: 0.541, 0.541, 0.541, 1
            size_hint_y: None
            height: self.texture_size[1]
            text_size: self.width, None

        Label:
            text: root.event_time
            halign: "left"
            font_size: "11sp"
            color: 0.541, 0.541, 0.541, 1
            size_hint_y: None
            height: self.texture_size[1]
            text_size: self.width, None

    PrimaryButton:
        id: edit_button
        size_hint_y: 0.75
        size_hint_x: 0.15
        text: "Edit"



<DocumentScanner>:
    orientation: 'vertical'

    HeaderLabel:
        text: "[b]Document Scanner[/b]"
        halign: "left"
        text_size: self.width - dp(16), self.height
        size_hint: (1, 0.2)

    Camera:
        id: camera
        resolution: (640, 480)
        play: False
        canvas.before:
            PushMatrix
            Rotate:
                angle: -90
                origin: self.center
        canvas.after:
            PopMatrix

    Label:
        id: loading_text
        opacity: 0
        text: "Loading..."

    BoxLayout:
        size_hint_y: None
        orientation: "vertical"
        height: '48dp'
        anchor_x: 'center'
        anchor_y: 'center'
        spacing: 10
        padding: 10

        PrimaryButton:
            id: scan_button
            text: '[b]Scan[/b]'
            size_hint_x: 1
            size_hint_y: None
            height: '48dp'
            on_press: root.capture()
            disabled: False

        PrimaryButton:
            id: upload_button
            text: '[b]Upload[/b]'
            size_hint_x: 1
            size_hint_y: None
            height: '48dp'
            on_press: root.upload()
            disabled: False